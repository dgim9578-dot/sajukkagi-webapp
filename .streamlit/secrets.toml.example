# Streamlit 로컬/클라우드 시크릿 예시
# ---------------------------------
# 1) 이 파일을 복사해 `.streamlit/secrets.toml` 로 저장하세요.
# 2) 아래 해시를 본인 비밀번호로 만든 bcrypt 문자열로 바꾸세요.
# 3) `secrets.toml` 은 절대 Git에 커밋하지 마세요.

# 해시 생성 (터미널):
#   python -c "import bcrypt; print(bcrypt.hashpw(b'여기에평문비밀번호', bcrypt.gensalt(rounds=12)).decode())"

# 현재 STEP12는 평문 `SAJU_ADMIN_PASSWORD`를 읽습니다. 운영 배포 후 즉시 긴 비밀번호로 교체하세요.
SAJU_ADMIN_PASSWORD = "REPLACE_WITH_STRONG_ADMIN_PASSWORD"
SAJU_ADMIN_ENABLED = "false"

# OpenAI 타로/AI 상담 기능을 사용할 때만 설정합니다.
# OPENAI_API_KEY = "sk-..."

# 공개 웹앱 브랜딩/상담/수익화 링크
SAJU_APP_NAME = "사주까기"
SAJU_OPERATOR_NAME = "사주까기 상담실"
SAJU_PUBLIC_PHONE = "010-8173-7471"
SAJU_KAKAO_OPENCHAT_URL = "https://open.kakao.com/o/s6OhFXni"
# 결제/예약 링크는 준비되면 입력합니다. 비워두면 버튼은 '준비중'으로 표시됩니다.
SAJU_PREMIUM_PAYMENT_URL = ""
SAJU_BOOKING_URL = ""
SAJU_PRIVACY_URL = ""
SAJU_TERMS_URL = ""
SAJU_AD_NOTICE = "일부 화면에는 광고 안내가 표시될 수 있습니다."

# 예전 bcrypt 해시 방식 보관용. 현재 앱 인증에는 사용하지 않습니다.
# ADMIN_PASSWORD_HASH = "$2b$12$REPLACE_WITH_OUTPUT_OF_COMMAND_ABOVE"

# 3D 브리핑(Next.js). 모바일·다른 기기에서는 localhost 대신 PC LAN IP를 씁니다.
# SAJU_BRIEFING_WEB_URL = "http://192.168.0.10:3000"

# (선택) TOML 섹션 형태로 쓰고 싶다면 대신 아래만 사용해도 됩니다.
# [admin]
# password_hash = "$2b$12$..."

# ----- 영속 저장(SAJU_STORAGE) — STEP11 공유 채팅·아카이브 등 -----
# 기본: SQLite (`saju_app.db`). Redis 사용 시 pip install redis 후:
#   SAJU_STORAGE=redis
#   REDIS_URL=redis://localhost:6379/0
# 선택: SAJU_SQLITE_PATH=C:/path/to/custom.db
# SQLite LOCK 대기(ms, 기본 30000): SAJU_SQLITE_BUSY_TIMEOUT_MS=30000
# gunicorn/uvicorn: worker마다 DB 연결이 따로 생깁니다. 동시 쓰기 많으면 worker 수를 줄이거나 Postgres 검토.
# Redis 방 키 TTL(초). 미설정 시 앱 기본 14일. 7일=604800, 30일=2592000, 영구=0(비권장)
# SAJU_REDIS_ROOM_TTL_SEC = "1209600"

# ----- STEP2 폼 프리필(생년월일·연락처 등) 디스크 저장용 Fernet 키 (필수 권장) -----
# 터미널: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# STEP2_PREFILL_FERNET_KEY = "gAAAAABl...44자_urlsafe_base64..."

# ----- STEP12 관리자 페이지 (선택) -----
# 쉼표로 구분한 클라이언트 IP만 허용. 비우거나 "*" 이면 제한 없음(운영에서는 지정 권장).
# 프록시 뒤에서는 X-Forwarded-For 첫 주소가 사용됩니다.
# ADMIN_IP_ALLOWLIST = "127.0.0.1,203.0.113.10"
